{
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/upload-token(.*)",
      "destination": "/api/upload-token.js"
    },
    {
      "source": "/api/blob-upload-token(.*)",
      "destination": "/api/upload-token.js"
    },
    {
      "source": "/api/blob-download(.*)",
      "destination": "/api/blob-download.js"
    },
    {
      "source": "/api/blob-delete(.*)",
      "destination": "/api/blob-delete.js"
    },
    {
      "source": "/api/blob-test(.*)",
      "destination": "/api/blob-test.js"
    },
    {
      "source": "/api/blob-diag(.*)",
      "destination": "/api/blob-diag.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/blob-delete?clean_abandoned=true",
      "schedule": "0 * * * *"
    }
  ]
}


