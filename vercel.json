{
  "routes": [
    {
      "src": "/api/upload-token(.*)",
      "dest": "api/upload-token.js"
    },
    {
      "src": "/api/blob-upload-token(.*)",
      "dest": "api/upload-token.js"
    },
    {
      "src": "/api/blob-download(.*)",
      "dest": "api/blob-download.js"
    },
    {
      "src": "/api/blob-delete(.*)",
      "dest": "api/blob-delete.js"
    },
    {
      "src": "/api/blob-test(.*)",
      "dest": "api/blob-test.js"
    },
    {
      "src": "/api/blob-diag(.*)",
      "dest": "api/blob-diag.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "frontend/index.html"
    },
    {
      "src": "/admin",
      "dest": "frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/blob-delete?clean_abandoned=true",
      "schedule": "0 * * * *"
    }
  ]
}

