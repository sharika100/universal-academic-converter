{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/upload-token.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/blob-download.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/blob-test.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/blob-diag.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/upload-token",
      "dest": "api/upload-token.js"
    },
    {
      "src": "/api/blob-upload-token",
      "dest": "api/upload-token.js"
    },
    {
      "src": "/api/blob-download",
      "dest": "api/blob-download.js"
    },
    {
      "src": "/api/blob-test",
      "dest": "api/blob-test.js"
    },
    {
      "src": "/api/blob-diag",
      "dest": "api/blob-diag.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/admin/(.*)",
      "dest": "frontend/index.html"
    },
    {
      "src": "/admin",
      "dest": "frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
